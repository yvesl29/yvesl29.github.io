---
import { apps, homeCopy, type Locale } from '../data/apps';
import '../styles/custom.css';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const copy = homeCopy[locale];
const alternateLocale: Locale = locale === 'en' ? 'fr' : 'en';
---

<html lang={copy.htmlLang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={copy.metaDescription} />
    <link rel="canonical" href={`/${locale}/`} />
    <link rel="alternate" hreflang="en" href="/en/" />
    <link rel="alternate" hreflang="fr" href="/fr/" />
    <link rel="alternate" hreflang="x-default" href="/" />
    <title>{copy.heading}</title>
  </head>
  <body class="home-page">
    <main class="home-shell">
      <header class="home-header">
        <div class="home-topline">
          <p class="home-kicker">{copy.kicker}</p>
          <nav class="home-language" aria-label={copy.languageLabel}>
            <a href={`/${alternateLocale}/`}>{copy.alternateLanguageText}</a>
          </nav>
        </div>
        <h1>{copy.heading}</h1>
        <p>{copy.intro}</p>
      </header>

      <section class="app-list" aria-label={copy.appsLabel}>
        {
          apps.map((app) => (
            <article class="app-card">
              <img src={app.icon} alt="" class="app-icon" width="64" height="64" />
              <div class="app-content">
                <h2>{app.name[locale]}</h2>
                <p>{app.description[locale]}</p>
                <section class="legal-link-group" aria-labelledby={`${app.slug}-${locale}-links`}>
                  <h3 id={`${app.slug}-${locale}-links`}>{copy.legalLinksHeading}</h3>
                  <ul>
                    {app.legalLinks.map((link) => (
                      <li>
                        <a href={link.href[locale]}>{link.label[locale]}</a>
                      </li>
                    ))}
                  </ul>
                </section>
                {'storeLinks' in app && (
                  <div class="store-badges">
                    <a
                      class="store-badge"
                      href={app.storeLinks.ios}
                      target="_blank"
                      rel="noopener noreferrer"
                      aria-label={`${copy.iosBadgeTop} ${copy.iosBadgeBottom}`}
                    >
                      <svg class="store-badge-icon" viewBox="0 0 384 512" aria-hidden="true" focusable="false">
                        <path
                          fill="currentColor"
                          d="M318.7 268.7c-.2-36.7 16.4-64.4 50-84.8-18.8-26.9-47.2-41.7-84.7-44.6-35.5-2.8-74.3 20.7-88.5 20.7-15 0-49.4-19.7-76.4-19.7C63.3 141.2 4 184.8 4 273.5q0 39.3 14.4 81.2c12.8 36.7 59 126.7 107.2 125.2 25.2-.6 43-17.9 75.8-17.9 31.8 0 48.3 17.9 76.4 17.9 48.6-.7 90.4-82.5 102.6-119.3-65.2-30.7-61.7-90-61.7-91.9zm-56.6-164.2c27.3-32.4 24.8-61.9 24-72.5-24.1 1.4-52 16.4-67.9 34.9-17.5 19.8-27.8 44.3-25.6 71.9 26.1 2 49.9-11.4 69.5-34.3z"
                        />
                      </svg>
                      <span class="store-badge-text">
                        <span class="store-badge-top">{copy.iosBadgeTop}</span>
                        <span class="store-badge-bottom">{copy.iosBadgeBottom}</span>
                      </span>
                    </a>
                    <a
                      class="store-badge"
                      href={app.storeLinks.android}
                      target="_blank"
                      rel="noopener noreferrer"
                      aria-label={`${copy.androidBadgeTop} ${copy.androidBadgeBottom}`}
                    >
                      <svg class="store-badge-icon" viewBox="0 0 512 512" aria-hidden="true" focusable="false">
                        <path
                          fill="#EA4335"
                          d="M325.3 234.3 104.6 13l280.8 161.2-60.1 60.1z"
                        />
                        <path
                          fill="#FBBC04"
                          d="M47 0C34 6.8 25.3 19.2 25.3 35.3v441.3c0 16.1 8.7 28.5 21.7 35.3l256.6-256L47 0z"
                        />
                        <path
                          fill="#4285F4"
                          d="M467.5 224.8 386 178.6l-64.9 64.9L386 308.4l83.1-46.2c16.3-9.1 16.3-32.1-1.6-37.4z"
                        />
                        <path
                          fill="#34A853"
                          d="M104.6 499 385.4 337.8l-60.1-60.1L47 512c8.5 4.4 18 4.2 27.5-1z"
                        />
                      </svg>
                      <span class="store-badge-text">
                        <span class="store-badge-top">{copy.androidBadgeTop}</span>
                        <span class="store-badge-bottom">{copy.androidBadgeBottom}</span>
                      </span>
                    </a>
                  </div>
                )}
              </div>
            </article>
          ))
        }
      </section>
    </main>

    <footer class="home-footer">
      <p>{copy.footer}</p>
    </footer>
  </body>
</html>
